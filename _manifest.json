{
  "manifest_version": 2,
  "id": "github.nguspring.selfie-painter",
  "version": "3.6.13",
  "name": "画家麦麦的自拍日常",
  "description": "集智能绘画与自拍生成于一体的 MaiBot 插件。支持文生图/图生图自动识别，兼容 OpenAI、OpenAI-Chat、豆包、Gemini、魔搭、ComfyUI 等多种 API 格式。内置日程系统、衣柜系统、三种自拍模式（standard/mirror/photo）、SSE 流式响应支持。提供命令式风格转换、模型配置管理、结果缓存、提示词优化、智能参考搜索等高级特性。",
  "author": {
    "name": "Ptrel, Rabbit-Jia-Er, saberlights Kiuon, nguspring",
    "url": "https://github.com/nguspring"
  },
  "license": "AGPL-3.0",
  "urls": {
    "repository": "https://github.com/nguspring/selfie_painter",
    "homepage": "https://github.com/nguspring/selfie_painter",
    "issues": "https://github.com/nguspring/selfie_painter/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "plugin_type": "extension",
  "dependencies": [],
  "capabilities": [
    "send.text",
    "send.image",
    "send.hybrid",
    "llm.generate",
    "llm.tool_call",
    "config.get",
    "config.get_plugin",
    "message.query",
    "chat.get_stream_by_user_id",
    "chat.get_stream_by_group_id"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  }
}
